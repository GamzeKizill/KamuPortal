@model KamuPortal.Models.Duyurular

<h2>Yeni Duyuru Ekle</h2>

<form asp-action="Create">

    <div class="mb-3">
        <label class="form-label">Başlık</label>
        <input asp-for="Baslik" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Tarih</label>
        <input asp-for="Tarih"
               type="date"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">İçerik</label>
        <textarea asp-for="Icerik"
                  class="form-control"
                  rows="5">
        </textarea>
    </div>

    <button type="submit"
            class="btn btn-success">
        Kaydet
    </button>

</form>