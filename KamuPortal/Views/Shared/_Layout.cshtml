@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KamuPortal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/KamuPortal.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    
                    <img src="~/images/valilikamblem.png"
                         alt="Valilik Amblemi"
                         width="32"
                         height="32"
                         class="me-2" />

                    Ankara Valiliği
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="#" Ana Sayfa></a>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link text-dark" 
                            asp-controller="Haberler"
                            asp-action="Index">
                            Haberler
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                            asp-controller="Duyurular"
                            asp-action="Index">
                            Duyurular
                        </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" href="#">İletişim</a>
                        </li>
                    </ul>

                <div>
                    @if (Context.Session.GetString("Admin") == null)
                    {
                    <a class="btn btn-outline-primary"
                        asp-controller="Admin"
                        asp-action="Login">
                        Giriş Yapın
                    </a>
                    }
                    else
                    {
                    <a class="btn btn-outline-success me-2"
                       asp-controller="Admin"
                       asp-action="Dashboard">
                       Dashboard
                    </a>

                    <a class="btn btn-outline-danger"
                        asp-controller="Admin"
                        asp-action="Logout">
                        Çıkış Yap
                    </a>
                     }
                </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid px-0">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - KamuPortal - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
